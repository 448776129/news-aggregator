{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "NEWS_TIMEZONE": "Asia/Shanghai",
    "GITHUB_RAW_BASE_URL": "https://raw.githubusercontent.com/448776129/news-aggregator/main"
  }
}
