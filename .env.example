# 可选：时区，用于按天分目录与日期字段（默认 Asia/Shanghai）
NEWS_TIMEZONE=Asia/Shanghai

# 可选：采集条数上限（默认 50）
NEWS_MAX_ITEMS=50

# 可选：并发采集线程数（默认 4）
NEWS_WORKERS=4

# 金十数据开放平台密钥（可选；不填则自动降级到公开快讯脚本）
JIN10_SECRET_KEY=

# Alpaca News API（可选；不填则跳过该源）
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# 可选：Alpaca 数据接口地址，默认 https://data.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# 可选：雪球 Cookie（可选；不填则先访问首页获取匿名 Cookie）
XUEQIU_COOKIE=

# 可选：查询接口在缺少本地数据时回退到 GitHub 仓库原始文件
# 例如：https://raw.githubusercontent.com/<owner>/<repo>/main
GITHUB_RAW_BASE_URL=
# 私有仓库可改用 GitHub API：设置 owner/repo 与 token
GITHUB_REPO=
GITHUB_TOKEN=

# 可选：覆盖数据源分类映射（JSON 字符串）
# 例如：{"reddit":"english","xueqiu":"finance"}
NEWS_SOURCE_CATEGORY_MAP=
